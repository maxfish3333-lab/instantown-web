rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── CHAT TRADING ──
    // Solo utenti autenticati possono leggere/scrivere le chat
    match /chats/{txId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── PROPRIETARI CHAT ──
    // Solo utenti autenticati
    match /chat_owners/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── QR-B EMESSI ──
    // Solo utenti autenticati
    match /qr_b_emessi/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── RICHIESTE REVERSE ──
    // Solo utenti autenticati
    match /richieste-reverse/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── TUTTO IL RESTO ──
    // Blocca per default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
