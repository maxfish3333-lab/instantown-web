rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // â”€â”€ CHAT TRADING â”€â”€
    // Solo utenti autenticati possono leggere/scrivere le chat
    match /chats/{txId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // â”€â”€ PROPRIETARI CHAT â”€â”€
    // Solo utenti autenticati
    match /chat_owners/{docId} {
      allow read, write: if request.auth != null;
    }

    // â”€â”€ QR-B EMESSI â”€â”€
    // Solo utenti autenticati
    match /qr_b_emessi/{docId} {
      allow read, write: if request.auth != null;
    }

    // â”€â”€ RICHIESTE REVERSE â”€â”€
    // Solo utenti autenticati â€” {document=**} estende il permesso anche
    // alla sottocollezione /proposte, altrimenti non ereditata automaticamente
    match /richieste-reverse/{docId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // -- COLLECTION GROUP: PROPOSTE (query trasversali su tutte le richieste) --
    // Necessaria perche' caricaPrenotazioniAccettate() in chat-esercente.html
    // usa collectionGroup('proposte'), che richiede una regola dedicata
    // separata da quella annidata sotto /richieste-reverse/{docId}.
    match /{path=**}/proposte/{propostaId} {
      allow read, write: if request.auth != null;
    }

    // â”€â”€ TUTTO IL RESTO â”€â”€
    // Blocca per default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
